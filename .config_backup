[core]
        repositoryformatversion = 0
        filemode = true
        bare = false
        logallrefupdates = true
        ignorecase = false
        precomposeunicode = true
[submodule]
        active = .
[remote "gitee"]
        url = https://gitee.com/vChewing/vChewing-VanguardLexicon.git
        fetch = +refs/heads/*:refs/remotes/gitlink/*
[remote "gitcode"]
        url = https://gitcode.net/vChewing/vChewing-VanguardLexicon.git/
        fetch = +refs/heads/*:refs/remotes/gitcode/*
[remote "github"]
        url = https://github.com/vChewing/vChewing-VanguardLexicon/
        fetch = +refs/heads/*:refs/remotes/github/*
[remote "all"]
        url = https://gitee.com/vChewing/vChewing-VanguardLexicon.git/
        fetch = +refs/heads/*:refs/remotes/all/*
        pushurl = https://gitee.com/vchewing/vChewing-VanguardLexicon.git/
        pushurl = https://gitlink.org.cn/vChewing/vChewing-VanguardLexicon.git/
        pushurl = https://gitcode.net/vChewing/vChewing-VanguardLexicon.git/
        pushurl = https://github.com/vChewing/vChewing-VanguardLexicon/
[lfs]
	repositoryformatversion = 0
[branch "main"]
	vscode-merge-base = origin/main
	remote = all
	merge = refs/heads/main
